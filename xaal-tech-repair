            <button onclick="closeBookingModal()" class="absolute top-6 right-6 text-slate-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-2xl font-black text-white mb-2">Book a Repair / Inquiry</h3>
            <p class="text-sm text-slate-400 mb-6">Fill out your details and device issue. We will respond swiftly to confirm your slot.</p>
            
            <form onsubmit="handleBookingSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Your Full Name</label>
                    <input type="text" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500" placeholder="John Smith">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Phone Number / Email</label>
                    <input type="text" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500" placeholder="07700 900000">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Select Service / Issue</label>
                    <select class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500">
                        <option>Laptop Speed Revival (500GB SSD) - £85</option>
                        <option>Laptop Speed Revival (1TB NVMe) - £125</option>
                        <option>iPhone 13 OLED Screen Replacement - £95</option>
                        <option>iPhone 11 Incell Screen Replacement - £65</option>
                        <option>Laptop Battery Replacement - £75</option>
                        <option>OS Recovery & Malware Removal - £50</option>
                        <option>Small Business VoIP / Network Setup - £100</option>
                        <option>General Diagnostic / Other Inquiry</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Handover Preference</label>
                    <select class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-500">
                        <option>Workshop Drop-Off (Potters Bar)</option>
                        <option>Local Foot Collection (Within 15 min walk)</option>
                        <option>Royal Mail Postal Return</option>
                        <option>Remote IT Desktop Support</option>
                    </select>
                </div>
                <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold py-3.5 rounded-xl transition shadow-lg shadow-cyan-500/20">
                    Submit Booking Request
                </button>
            </form>
        </div>
    </div>

    <script>
        function openBookingModal() {
            document.getElementById('bookingModal').classList.remove('hidden');
            document.getElementById('bookingModal').classList.add('flex');
        }
        function closeBookingModal() {
            document.getElementById('bookingModal').classList.remove('flex');
            document.getElementById('bookingModal').classList.add('hidden');
        }
        function handleBookingSubmit(event) {
            event.preventDefault();
            alert('Thank you! Your request has been received. We will contact you shortly to confirm your booking.');
            closeBookingModal();
        }
    </script>
